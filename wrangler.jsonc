// Cloudflare Worker config. Push to main deploys it via Workers Builds, see CLAUDE.md, Deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-roundtable",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  // The MCP SDK needs Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  // Conversations for continuation_id, see src/store.js and CLAUDE.md, Storage.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-roundtable",
      "database_id": "550def2c-7fac-4494-b862-66473b5d5f13",
      "migrations_dir": "migrations"
    }
  ],
  // Cached model list, one hour, see src/openrouter.js.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c830f48406c24a4ca44ff231ddb3dbd4"
    }
  ]
}
